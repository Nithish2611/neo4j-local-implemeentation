NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# LLM: the local `claude` CLI (Claude Code), already installed and logged in.
# No API key needed here. Leave these unset to use `claude` on PATH with its default model.
# CLAUDE_CLI=claude
# CLAUDE_MODEL=sonnet
# CLAUDE_TIMEOUT=180
